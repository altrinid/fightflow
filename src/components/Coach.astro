---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { coach, photos } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="section coach" id="coach" aria-labelledby="coach-title">
  <div class="container coach__grid">
    <figure class="coach__visual" data-reveal>
      <Picture
        src={photos.coach.src}
        alt={photos.coach.alt[lang]}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) 92vw, 42vw"
        quality={70}
        class="coach__photo"
      />
      <figcaption class="coach__caption">
        <span class="coach__role">{d.coach.role}</span>
        {coach.name && <span class="coach__name">{coach.name}</span>}
      </figcaption>
    </figure>

    <div class="coach__copy">
      <p class="eyebrow" data-reveal>{d.coach.eyebrow}</p>
      <h2 class="h2" id="coach-title" data-reveal style="--d:80ms">{d.coach.title}</h2>
      <p class="lead" data-reveal style="--d:160ms">{d.coach.text}</p>

      <ul class="coach__titles" role="list" data-reveal style="--d:220ms">
        {
          d.coach.titles.map((title) => (
            <li>
              <Icon name="star" size={20} />
              <span>{title}</span>
            </li>
          ))
        }
      </ul>

      <ul class="coach__disciplines" role="list" data-reveal style="--d:280ms">
        {d.coach.disciplines.map((x) => <li>{x}</li>)}
      </ul>

      <a class="btn btn--primary coach__cta" href="#join" data-form-type="trial" data-reveal style="--d:320ms">
        {d.hero.ctaPrimary}<Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .coach {
    overflow: hidden;
  }

  .coach__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--space-l);
    align-items: center;
  }

  .coach__visual {
    position: relative;
    margin: 0;
  }

  .coach__visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--radius-l);
  }

  .coach__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    background: linear-gradient(180deg, transparent 55%, rgb(11 11 13 / 0.55));
    pointer-events: none;
  }

  .coach__caption {
    position: absolute;
    z-index: 1;
    right: -0.75rem;
    bottom: 1.5rem;
    display: grid;
    gap: 0.1rem;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius);
    background: var(--c-red);
    color: #fff;
    box-shadow: 0 18px 40px -18px rgb(200 69 58 / 0.8);
  }

  .coach__role {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .coach__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    text-transform: uppercase;
  }

  .coach__copy {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .coach__titles {
    display: grid;
    width: 100%;
    margin-top: 0.5rem;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .coach__titles li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .coach__titles li:first-child {
    color: var(--c-red-text);
  }

  .coach__titles :global(svg) {
    flex: none;
    color: var(--c-red);
    fill: var(--c-red);
  }

  .coach__disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .coach__disciplines li {
    padding: 0.5rem 1rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .coach__cta {
    margin-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .coach__grid {
      grid-template-columns: 1fr;
    }

    .coach__visual {
      max-width: 32rem;
    }

    .coach__caption {
      right: 1rem;
    }
  }
</style>
