---
import Icon from './Icon.astro';
import Accent from './Accent.astro';
import { club } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const cards = [
  { icon: 'mail', label: c.email, value: club.email, href: `mailto:${club.email}` },
  { icon: 'phone', label: c.phone, value: club.phone, href: club.phoneHref },
  { icon: 'instagram', label: c.instagram, value: club.instagram.handle, href: club.instagram.url },
] as const;
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__left">
        <div class="section-head contact__head">
          <p class="eyebrow" data-reveal>{c.eyebrow}</p>
          <h2 class="h2" id="contact-title" data-reveal style="--d:80ms"><Accent text={c.title} /></h2>
          <p class="lead" data-reveal style="--d:160ms">{c.lead}</p>
        </div>

        <ul class="contact__cards" role="list">
          {
            cards.map((card, i) => (
              <li data-reveal style={`--d:${i * 70}ms`}>
                <a class="contact__card" href={card.href} rel={card.icon === 'instagram' ? 'noopener' : undefined}>
                  <span class="contact__icon">
                    <Icon name={card.icon} />
                  </span>
                  <span class="contact__text">
                    <span class="contact__k">{card.label}</span>
                    <span class="contact__v">{card.value}</span>
                  </span>
                  <Icon name="arrow" class="contact__go" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="map" data-reveal style="--d:120ms">
        <div class="map__frame" data-map data-src={club.maps.embed} data-title={c.mapTitle}>
          <div class="map__placeholder">
            <span class="map__pin" aria-hidden="true"><Icon name="pin" size={28} /></span>
            <p class="map__title">{c.address}</p>
            <address class="map__address">
              {club.gym.street}, {club.gym.door[lang]}<br />
              {club.gym.postalCode} {club.gym.city[lang]} – {club.gym.district}
            </address>
            <div class="map__actions">
              <button class="btn btn--primary" type="button" data-map-load>
                <Icon name="map" size={18} />{c.mapLoad}
              </button>
              <a class="btn btn--ghost" href={club.maps.open} rel="noopener">{c.mapOpen}</a>
            </div>
            <p class="map__note">{c.mapNote}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-l);
    align-items: stretch;
  }

  .contact__head {
    margin-bottom: var(--space-m);
  }

  .contact__cards {
    display: grid;
    gap: 0.75rem;
    list-style: none;
  }

  .contact__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-ink-2);
    text-decoration: none;
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease-out),
      background-color 0.3s;
  }

  .contact__card:hover {
    border-color: rgb(200 69 58 / 0.6);
    background: var(--c-ink-3);
    transform: translateX(4px);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgb(200 69 58 / 0.14);
    color: var(--c-red-text);
  }

  .contact__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .contact__k {
    color: var(--c-text-dim);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact__v {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .contact__card :global(.contact__go) {
    color: var(--c-text-dim);
    transition:
      transform 0.3s var(--ease-out),
      color 0.3s;
  }

  .contact__card:hover :global(.contact__go) {
    color: var(--c-red-text);
    transform: translateX(3px);
  }

  .map {
    min-height: 26rem;
  }

  .map__frame {
    position: relative;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background:
      radial-gradient(60% 80% at 70% 30%, rgb(200 69 58 / 0.18), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 46px, rgb(255 255 255 / 0.04) 46px 47px),
      repeating-linear-gradient(90deg, transparent 0 46px, rgb(255 255 255 / 0.04) 46px 47px),
      var(--c-ink-2);
  }

  .map__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.4) contrast(1.05);
  }

  .map__placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    min-height: inherit;
    padding: 2rem;
    text-align: center;
  }

  .map__pin {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--c-red);
    color: #fff;
    box-shadow: 0 16px 36px -12px rgb(200 69 58 / 0.8);
  }

  .map__pin :global(svg) {
    transform: rotate(45deg);
  }

  .map__title {
    margin-top: 0.75rem;
    color: var(--c-text-dim);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .map__address {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem);
    font-style: normal;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .map__note {
    max-width: 34ch;
    color: var(--c-text-dim);
    font-size: 0.8125rem;
  }

  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
