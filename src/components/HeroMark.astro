<style>
  .mark {
    display: grid;
    grid-template-columns: 203.7fr 200.8fr;
    column-gap: 2.6%;
    align-items: end;
    margin: clamp(1.25rem, 3vw, 2.5rem) 0 clamp(1.5rem, 3.5vw, 3rem);
  }

  .mark__word {
    display: block;
    overflow: hidden;
  }

  .mark__word svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    animation: mark-rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mark__word--fight path {
    fill: none;
    stroke: var(--c-text);
    stroke-width: 0.85;
    stroke-linejoin: round;
  }

  .mark__word--flow svg {
    animation-delay: 0.12s;
  }

  @keyframes mark-rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  @media (max-width: 640px) {
    .mark {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
    }

    .mark__word--flow {
      width: 98.6%;
    }

    .mark__word--fight path {
      stroke-width: 1.1;
    }
  }
</style>
