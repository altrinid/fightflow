---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Ticker from './Ticker.astro';
import Why from './Why.astro';
import Coach from './Coach.astro';
import Gym from './Gym.astro';
import Training from './Training.astro';
import Community from './Community.astro';
import Pricing from './Pricing.astro';
import Register from './Register.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import { club, prices, schedule } from '../data/site';
import { t, url, route, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const site = Astro.site ?? new URL('https://www.fightflow.at');
const pageUrl = new URL(route('home', lang), site).href;
const homeUrl = new URL(route('home', 'de'), site).href;
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsClub',
    '@id': `${homeUrl}#club`,
    name: club.name,
    legalName: club.legalName,
    alternateName: 'Kampfsportverein FightFlow Wien',
    description: d.meta.description,
    url: pageUrl,
    image: new URL(url('og-image.jpg'), site).href,
    logo: new URL(url('icon-512.png'), site).href,
    email: club.email,
    telephone: club.phone,
    sport: club.sport[lang],
    sameAs: [club.instagram.url],
    priceRange: lang === 'de' ? '0–79 €' : '€0–79',
    address: {
      '@type': 'PostalAddress',
      streetAddress: `${club.gym.street}/17`,
      postalCode: club.gym.postalCode,
      addressLocality: 'Wien',
      addressRegion: 'Wien',
      addressCountry: club.gym.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: club.gym.geo.lat, longitude: club.gym.geo.lng },
    hasMap: club.maps.open,
    openingHoursSpecification: schedule.map((s) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${dayNames[s.weekday]}`,
      opens: s.start,
      closes: s.end,
    })),
    memberOf: { '@type': 'SportsOrganization', name: club.umbrella.name, url: club.umbrella.url },
    makesOffer: prices.map((p) => ({
      '@type': 'Offer',
      name: p.name[lang],
      price: p.price.toFixed(2),
      priceCurrency: 'EUR',
      ...(p.monthly
        ? {
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: p.price,
              priceCurrency: 'EUR',
              unitCode: 'MON',
            },
          }
        : {}),
      url: `${pageUrl}#pricing`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    name: 'FightFlow',
    url: homeUrl,
    inLanguage: lang === 'de' ? 'de-AT' : 'en',
    publisher: { '@id': `${homeUrl}#club` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base lang={lang} title={d.meta.title} description={d.meta.description} routeKey="home" jsonLd={jsonLd}>
  <Hero lang={lang} />
  <Ticker lang={lang} />
  <Why lang={lang} />
  <Coach lang={lang} />
  <Gym lang={lang} />
  <Training lang={lang} />
  <Community lang={lang} />
  <Pricing lang={lang} />
  <Register lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</Base>
