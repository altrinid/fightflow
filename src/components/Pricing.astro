---
import Icon from './Icon.astro';
import Accent from './Accent.astro';
import { prices } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const pr = d.pricing;
const meta = (p: (typeof prices)[number]) =>
  p.monthly && p.trainingsPerWeek ? pr.perWeek(p.trainingsPerWeek) : p.id === 'single' ? pr.perSession : '';
---

<section class="section section--bone pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{pr.eyebrow}</p>
      <h2 class="h2" id="pricing-title" data-reveal style="--d:80ms"><Accent text={pr.title} /></h2>
      <p class="lead" data-reveal style="--d:160ms">{pr.lead}</p>
    </div>

    <ul class="prices" role="list">
      {
        prices.map((p, i) => (
          <li class:list={['price', `price--${p.id}`, { 'price--featured': p.featured }]} data-reveal style={`--d:${i * 80}ms`}>
            {p.featured && <span class="price__badge">{pr.best}</span>}
            <h3 class="price__name">{p.name[lang]}</h3>
            <p class="price__amount">
              {p.price === 0 ? (
                <span class="price__num">{pr.free}</span>
              ) : lang === 'en' ? (
                <>
                  <span class="price__cur">€</span>
                  <span class="price__num">{p.price}</span>
                </>
              ) : (
                <>
                  <span class="price__num">{p.price}</span>
                  <span class="price__cur">€</span>
                </>
              )}
              {p.monthly && <span class="price__period">{pr.perMonth}</span>}
            </p>
            {meta(p) && <p class="price__meta">{meta(p)}</p>}
            <p class="price__note">{pr.notes[p.id]}</p>
            <a
              class:list={['btn', p.featured || p.id === 'trial' ? 'btn--primary' : 'btn--ghost', 'btn--block']}
              href="#join"
              data-form-type={p.id === 'trial' ? 'trial' : 'membership'}
              data-membership={p.id === 'trial' ? undefined : p.id}
            >
              {p.id === 'trial' ? pr.ctaTrial : pr.ctaChoose}
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .prices {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    list-style: none;
  }

  .price {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border: 1px solid var(--c-line-bone);
    border-radius: var(--radius-l);
    background: #f8f5ef;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .price:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 50px -30px rgb(20 19 18 / 0.45);
  }

  .price--trial {
    border-color: rgb(200 69 58 / 0.45);
  }

  .price--featured {
    border-color: transparent;
    background:
      radial-gradient(90% 60% at 100% 0%, rgb(200 69 58 / 0.4), transparent 65%),
      var(--c-ink);
    color: var(--c-text);
    color-scheme: dark;
    box-shadow: 0 40px 80px -40px rgb(20 19 18 / 0.7);
  }

  .price__badge {
    position: absolute;
    top: -0.8rem;
    left: clamp(1.5rem, 2.5vw, 2rem);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--c-red);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .price__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .price__amount {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    line-height: 0.9;
  }

  .price__num {
    font-size: clamp(3.25rem, 2.4rem + 3vw, 4.75rem);
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .price--trial .price__num {
    color: var(--c-red-600);
  }

  .price__cur {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    color: var(--c-red-600);
  }

  .price--featured .price__cur {
    color: var(--c-red-text);
  }

  .price__period {
    margin-left: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-on-bone-dim);
  }

  .price--featured .price__period,
  .price--featured .price__meta,
  .price--featured .price__note {
    color: var(--c-text-dim);
  }

  .price__meta {
    font-weight: 700;
  }

  .price--featured .price__meta {
    color: var(--c-text);
  }

  .price__note {
    flex: 1;
    color: var(--c-on-bone-dim);
    font-size: 0.9375rem;
  }

  .price .btn {
    margin-top: 0.75rem;
  }

  .price--featured .btn--ghost {
    --btn-fg: var(--c-text);
    --btn-bd: var(--c-line-strong);
  }


  @media (max-width: 1100px) {
    .prices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.75rem;
    }

  }

  @media (max-width: 600px) {
    .prices {
      grid-template-columns: 1fr;
    }
  }
</style>
