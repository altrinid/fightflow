---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="section section--bone faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="section-head faq__head">
      <p class="eyebrow" data-reveal>{d.faq.eyebrow}</p>
      <h2 class="h2" id="faq-title" data-reveal style="--d:80ms">{d.faq.title}</h2>
    </div>

    <div class="faq__list" data-reveal style="--d:120ms">
      {
        d.faq.items.map((item, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-l);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    margin: 0;
  }

  .faq__list {
    border-top: 1px solid var(--c-line-bone);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line-bone);
    interpolate-size: allow-keywords;
  }

  .faq__item::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.4s var(--ease-out),
      content-visibility 0.4s allow-discrete;
  }

  .faq__item[open]::details-content {
    height: auto;
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--c-red-600);
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--c-line-bone);
    border-radius: 50%;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: currentColor;
  }

  .faq__icon::after {
    transform: rotate(90deg);
    transition: transform 0.4s var(--ease-out);
  }

  .faq__item[open] .faq__icon {
    border-color: var(--c-red);
    background: var(--c-red);
    color: #fff;
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-bottom: 1.5rem;
  }

  .faq__a p {
    max-width: 62ch;
    color: var(--c-on-bone-dim);
  }

  @media (max-width: 860px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__head {
      position: static;
    }
  }
</style>
