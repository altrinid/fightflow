---
import { Image } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import { club } from '../data/site';

/** The club's fist logo on an off-white medallion (so the charcoal part stays visible on dark), plus the wordmark. */
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}

const { size = 44, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--logo-size:${size}px`}>
  <span class="logo__badge">
    <Image src={club.logo} alt="" width={size} height={size} densities={[1, 2, 3]} loading="eager" class="logo__img" />
  </span>
  {wordmark && <Wordmark title="" class="logo__word" />}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.24);
  }

  .logo__badge {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 50%;
    background: #f4f1ec;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.06);
  }

  .logo__badge :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .logo :global(.logo__word) {
    width: calc(var(--logo-size) * 2.9);
    height: auto;
  }
</style>
