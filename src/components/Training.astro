---
import Icon, { type IconName } from './Icon.astro';
import { club, schedule } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const s = d.training.schedule;
const icons: IconName[] = ['target', 'users', 'bolt', 'shield'];
---

<section class="section section--ink2 training" id="training" aria-labelledby="training-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{d.training.eyebrow}</p>
      <h2 class="h2" id="training-title" data-reveal style="--d:80ms">{d.training.title}</h2>
      <p class="lead" data-reveal style="--d:160ms">{d.training.lead}</p>
    </div>

    <ol class="training__list" role="list">
      {
        d.training.items.map((item, i) => (
          <li class="training__item" data-reveal style={`--d:${i * 80}ms`}>
            <span class="training__num" aria-hidden="true">
              0{i + 1}
            </span>
            <div class="training__body">
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </div>
            <span class="training__icon">
              <Icon name={icons[i] ?? 'target'} size={22} />
            </span>
          </li>
        ))
      }
    </ol>

    <div class="schedule" data-reveal>
      <div class="schedule__intro">
        <h3 class="h3 schedule__title">
          <Icon name="clock" size={22} />
          {s.title}
        </h3>
        {schedule.length === 0 && <p class="schedule__empty">{s.empty}</p>}
        <p class="schedule__loc">
          <Icon name="pin" size={18} />
          <span><strong>{s.location}:</strong> {s.locationValue}</span>
        </p>
      </div>

      {
        schedule.length > 0 ? (
          <table class="schedule__table">
            <tbody>
              {schedule.map((slot) => (
                <tr>
                  <th scope="row">{slot.day[lang]}</th>
                  <td>{slot.time}</td>
                  <td>{slot.title[lang]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div class="schedule__actions">
            <a class="btn btn--primary" href={club.phoneHref}>
              <Icon name="phone" size={18} />
              {s.call}
            </a>
            <a class="btn btn--ghost" href={`mailto:${club.email}`}>
              <Icon name="mail" size={18} />
              {s.write}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .training__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .training__item {
    position: relative;
    display: grid;
    grid-template-columns: clamp(2.75rem, 2.3rem + 2vw, 4.25rem) minmax(0, 1fr) auto;
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(0rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--c-line);
    transition: background-color 0.3s;
  }

  .training__item:nth-child(odd) {
    border-right: 1px solid var(--c-line);
  }

  .training__item:hover {
    background: rgb(255 255 255 / 0.025);
  }

  .training__num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-line-strong);
    transition:
      color 0.3s,
      -webkit-text-stroke-color 0.3s;
  }

  .training__item:hover .training__num {
    color: var(--c-red);
    -webkit-text-stroke-color: var(--c-red);
  }

  .training__body {
    display: grid;
    gap: 0.5rem;
  }

  .training__body p {
    color: var(--c-text-dim);
  }

  .training__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    color: var(--c-red);
  }

  .schedule {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    gap: var(--space-m);
    align-items: center;
    margin-top: var(--space-l);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--c-line);
    border-left: 4px solid var(--c-red);
    border-radius: var(--radius-l);
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(225 29 39 / 0.14), transparent 70%),
      var(--c-ink-3);
  }

  .schedule__intro {
    display: grid;
    gap: 0.75rem;
  }

  .schedule__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .schedule__title :global(svg) {
    color: var(--c-red);
  }

  .schedule__empty {
    max-width: 56ch;
    color: var(--c-text-dim);
  }

  .schedule__loc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .schedule__loc :global(svg) {
    flex: none;
    color: var(--c-red);
  }

  .schedule__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .schedule__table {
    width: 100%;
    border-collapse: collapse;
  }

  .schedule__table th,
  .schedule__table td {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--c-line);
    text-align: left;
  }

  .schedule__table th {
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .training__list {
      grid-template-columns: 1fr;
    }

    .training__item:nth-child(odd) {
      border-right: 0;
    }

    .schedule {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .training__item {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .training__icon {
      display: none;
    }
  }
</style>
