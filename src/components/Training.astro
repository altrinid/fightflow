---
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import Accent from './Accent.astro';
import { club, schedule, photos } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const tr = d.training;
const icons: IconName[] = ['users', 'bolt', 'shield', 'check'];
---

<section class="section training" id="training" aria-labelledby="training-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{tr.eyebrow}</p>
      <h2 class="h2" id="training-title" data-reveal style="--d:80ms"><Accent text={tr.title} /></h2>
      <p class="lead" data-reveal style="--d:160ms">{tr.lead}</p>
    </div>

    <div class="training__grid">
      <div class="schedule" data-reveal>
        <h3 class="schedule__title">
          <Icon name="clock" size={22} />
          {tr.scheduleTitle}
        </h3>
        <ul class="schedule__list" role="list">
          {
            schedule.map((s) => (
              <li>
                <span class="schedule__day">{s.day[lang]}</span>
                <span class="schedule__time">
                  {s.start}–{s.end}
                  {tr.clock && <span class="schedule__unit"> {tr.clock}</span>}
                </span>
              </li>
            ))
          }
        </ul>
        <address class="schedule__loc">
          <Icon name="pin" size={20} />
          <span>
            <strong>{club.gym.street}, {club.gym.door[lang]}</strong><br />
            {club.gym.postalCode} {club.gym.city[lang]} – {club.gym.district}
          </span>
        </address>
        <div class="schedule__actions">
          <a class="btn btn--primary" href="#join" data-form-type="trial">{tr.book}<Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={club.maps.directions} rel="noopener"><Icon name="route" size={18} />{tr.directions}</a>
        </div>
      </div>

      <ul class="training__points" role="list">
        {
          tr.items.map((item, i) => (
            <li data-reveal style={`--d:${i * 80}ms`}>
              <span class="training__icon">
                <Icon name={icons[i] ?? 'check'} size={22} />
              </span>
              <div>
                <h3 class="training__point-title">{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="training__scroller" data-scroller role="region" aria-label={tr.photosLabel}>
    <ul class="training__photos" role="list">
      {
        photos.training.map((p, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <Image
              src={p.src}
              alt={p.alt[lang]}
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 700px) 70vw, 25vw"
              quality={68}
              loading="lazy"
              decoding="async"
              style={p.position ? `object-position:${p.position}` : undefined}
            />
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<style>
  .training__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: stretch;
  }

  .schedule {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--c-line);
    border-top: 4px solid var(--c-red);
    border-radius: var(--radius-l);
    background:
      radial-gradient(70% 100% at 100% 0%, rgb(200 69 58 / 0.16), transparent 70%),
      var(--c-ink-3);
  }

  .schedule__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .schedule__title :global(svg) {
    color: var(--c-red-text);
  }

  .schedule__list {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .schedule__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--c-line);
  }

  .schedule__day {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .schedule__time {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .schedule__unit {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-text-dim);
  }

  .schedule__loc {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-style: normal;
    line-height: 1.5;
    color: var(--c-text-dim);
  }

  .schedule__loc strong {
    color: var(--c-text);
  }

  .schedule__loc :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--c-red-text);
  }

  .schedule__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .training__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
    list-style: none;
  }

  .training__points li {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-ink-2);
  }

  .training__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(200 69 58 / 0.14);
    color: var(--c-red-text);
  }

  .training__point-title {
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .training__points p {
    color: var(--c-text-dim);
    font-size: 0.9375rem;
  }

  .training__photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.9rem);
    margin-top: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
  }

  .training__photos li {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--c-ink-3);
  }

  .training__photos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .training__photos li:hover :global(img) {
    transform: scale(1.04);
  }

  @media (max-width: 960px) {
    .training__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .training__scroller {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .training__scroller::-webkit-scrollbar {
      display: none;
    }

    .training__photos {
      display: flex;
      gap: 0.75rem;
    }

    .training__photos li {
      flex: 0 0 66%;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 520px) {
    .training__points {
      grid-template-columns: 1fr;
    }
  }
</style>
