---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, url, route, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Which page this is – used for canonical + hreflang alternates. Omit for pages without a counterpart (404). */
  routeKey?: RouteKey;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, routeKey, noindex = false, jsonLd = [] } = Astro.props;
const d = t(lang);
const site = Astro.site ?? new URL('https://www.fightflow.at');
const abs = (path: string) => new URL(path, site).href;

const canonical = routeKey ? abs(route(routeKey, lang)) : undefined;
const alternates = routeKey
  ? [
      { hreflang: 'de-AT', href: abs(route(routeKey, 'de')) },
      { hreflang: 'en', href: abs(route(routeKey, 'en')) },
      { hreflang: 'x-default', href: abs(route(routeKey, 'de')) },
    ]
  : [];
const ogImage = abs(url('og-image.jpg'));
const robots = noindex || import.meta.env.PUBLIC_NOINDEX === 'true' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang={lang === 'de' ? 'de-AT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FightFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={d.locale} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_AT'} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <Header lang={lang} routeKey={routeKey ?? 'home'} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} routeKey={routeKey ?? 'home'} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
